# Copy to `.env` for local development, or pass the same variables on the host / in ECS / EC2.

# Required for bill parsing unless the app loads the key from AWS Secrets Manager (see `app/gemini_api_key.py`).
BILLSPLIT_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.0-flash,gemini-1.5-flash
